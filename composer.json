{
  "name": "kolirt/frontpad.ru-sdk",
  "description": "sdk for frontpad.ru",
  "keywords": [
    "sdk",
    "frontpad.ru"
  ],
  "license": "MIT",
  "version": "0.0.7",
  "authors": [
    {
      "name": "kolirt"
    }
  ],
  "require": {
    "guzzlehttp/guzzle": "> 6.0.0",
    "psr/http-message": "^1.0 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.5 || ^9.6"
  },
  "autoload": {
    "files": [
      "src/helpers.php"
    ],
    "psr-4": {
      "Kolirt\\Frontpad\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kolirt\\Frontpad\\Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {}
  }
}
